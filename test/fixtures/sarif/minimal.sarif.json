{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "TestTool",
          "version": "1.0.0",
          "rules": [
            {
              "id": "RULE001",
              "shortDescription": { "text": "Test rule description" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "RULE001",
          "level": "warning",
          "message": { "text": "A test finding" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/app.ts" },
                "region": { "startLine": 10, "endLine": 10 }
              }
            }
          ]
        }
      ]
    }
  ]
}
